 /* ── Calcular y renderizar estadísticas (getDashboard nativo) ── */
+/* ── Lectura de asistencia del miembro ─────────────────
+   Ruta real de los datos: asistencia/{anio}/{fecha}/{uid}. Cada doc vive en una
+   colección cuyo id es la FECHA, así que collectionGroup("asistencia") no puede
+   encontrarlos (y además exige una regla /{path=**}/asistencia/{doc}).
+   Se lee 1 getDoc por asamblea, en paralelo, y se cachea por uid. */
+let _asambleasPromise = null;
+function cargarAsambleas() {
+  if (!_asambleasPromise) {
+    _asambleasPromise = getDocs(collection(db, "asambleas")).then(snap => {
+      const out = [];
+      snap.forEach(d => {
+        const a = d.data();
+        if (a.hayAsamblea === true && a.fecha) out.push({ id: d.id, fecha: a.fecha, horaInicio: a.horaInicio });
+      });
+      out.sort((x, y) => x.fecha.localeCompare(y.fecha));
+      return out;
+    });
+    _asambleasPromise.catch(() => { _asambleasPromise = null; });
+  }
+  return _asambleasPromise;
+}
+
+let _asistCache = { uid: null, promise: null };
+function leerAsistenciasMiembro(uid) {
+  if (_asistCache.uid === uid && _asistCache.promise) return _asistCache.promise;
+  const promise = (async () => {
+    const hoy = new Date().toISOString().slice(0, 10);
+    const asambleas = (await cargarAsambleas()).filter(a => a.fecha <= hoy);
+    const mapa = new Map();               // fecha -> doc (solo presentes)
+    let denegados = 0;
+    await Promise.all(asambleas.map(async (a) => {
+      try {
+        const snap = await getDoc(doc(db, "asistencia", a.fecha.slice(0, 4), a.fecha, uid));
+        if (snap.exists() && snap.data().presente === true) mapa.set(a.fecha, { ...snap.data(), fecha: a.fecha });
+      } catch (e) {
+        if (e && e.code === "permission-denied") denegados++; else throw e;
+      }
+    }));
+    if (denegados > 0) {
+      const err = new Error("permission-denied en " + denegados + " lecturas de asistencia");
+      err.code = "permission-denied";
+      throw err;
+    }
+    return mapa;
+  })();
+  _asistCache = { uid, promise };
+  promise.catch(() => { _asistCache = { uid: null, promise: null }; });
+  return promise;
+}
