{
  "colors": {
    "primary": "#F5C518",
    "primaryHover": "#e09a2e",
    "primaryDark": "#C4703A",
    "secondary": "#4A8FA8",
    "accent": "#C4869A",
    "success": "#2e9e6b",
    "warning": "#d4881a",
    "error": "#d94040",
    "background": "#16120d",
    "backgroundAlt": "#1f1a12",
    "backgroundCard": "#2a2218",
    "backgroundHover": "#332a1c",
    "surface": "#FBF7EE",
    "surfaceDark": "#1c1814",
    "textPrimary": "#1c1814",
    "textOnDark": "#FBF7EE",
    "textMuted": "#5e554a",
    "textOnPrimary": "#1c1814",
    "border": "#e8e2d4",
    "borderSubtle": "rgba(255,255,255,0.08)",
    "borderSubtle2": "rgba(255,255,255,0.13)",
    "shadow": "0 8px 32px -8px rgba(28,24,20,0.12)",
    "shadowLg": "0 20px 60px -16px rgba(28,24,20,0.20)",
    "glow": "rgba(245,197,24,0.25)"
  },
  "typography": {
    "fontFamilies": {
      "heading": "'Lora', serif",
      "body": "'Outfit', sans-serif",
      "mono": "'JetBrains Mono', monospace",
      "display": "'Bebas Neue', sans-serif"
    },
    "fontSizes": {
      "xs": "10px",
      "sm": "11px",
      "base": "14px",
      "lg": "16px",
      "xl": "20px",
      "2xl": "28px",
      "3xl": "36px",
      "4xl": "clamp(26px,4vw,38px)",
      "5xl": "clamp(32px,5vw,48px)"
    },
    "fontWeights": {
      "normal": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800
    },
    "lineHeights": {
      "tight": 1.1,
      "normal": 1.5,
      "relaxed": 1.7
    },
    "letterSpacings": {
      "tight": "0.02em",
      "normal": "0",
      "wide": "0.05em",
      "wider": "0.1em"
    }
  },
  "spacing": {
    "scale": [
      "4px",
      "8px",
      "12px",
      "16px",
      "20px",
      "24px",
      "28px",
      "32px",
      "40px",
      "48px",
      "64px",
      "80px",
      "96px"
    ],
    "container": {
      "maxWidth": "1200px",
      "padding": "28px"
    }
  },
  "borderRadius": {
    "none": "0",
    "sm": "6px",
    "md": "10px",
    "lg": "14px",
    "xl": "20px",
    "full": "100px"
  },
  "shadows": {
    "none": "none",
    "sm": "0 2px 8px -2px rgba(28,24,20,0.1)",
    "base": "0 8px 32px -8px rgba(28,24,20,0.12)",
    "lg": "0 20px 60px -16px rgba(28,24,20,0.20)",
    "glow": "0 0 24px -4px rgba(245,197,24,0.25)",
    "inner": "inset 0 2px 4px rgba(0,0,0,0.06)"
  },
  "transitions": {
    "fast": "150ms cubic-bezier(0.4,0,0.2,1)",
    "base": "250ms cubic-bezier(0.4,0,0.2,1)",
    "spring": "500ms cubic-bezier(0.34,1.4,0.64,1)",
    "easeOutQuint": "400ms cubic-bezier(0.23,1,0.32,1)",
    "easeOutExpo": "500ms cubic-bezier(0.19,1,0.22,1)"
  },
  "zIndices": {
    "base": 1,
    "dropdown": 100,
    "sticky": 100,
    "modal": 500,
    "popover": 600,
    "tooltip": 700,
    "toast": 999
  },
  "breakpoints": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px"
  },
  "components": {
    "button": {
      "height": "44px",
      "minHeight": "44px",
      "paddingX": "22px",
      "fontSize": "14px",
      "fontWeight": 700,
      "borderRadius": "100px",
      "primary": {
        "background": "linear-gradient(135deg,#F5C518,#e09a2e,#C4703A)",
        "color": "#1c1814",
        "shadow": "0 8px 24px -8px rgba(245,197,24,0.35)"
      },
      "secondary": {
        "background": "rgba(255,255,255,0.06)",
        "color": "#5e554a",
        "border": "1px solid rgba(255,255,255,0.08)"
      },
      "danger": {
        "background": "rgba(224,60,60,0.15)",
        "color": "#f08080",
        "border": "1px solid rgba(224,60,60,0.3)"
      }
    },
    "input": {
      "height": "44px",
      "padding": "13px 16px",
      "fontSize": "15px",
      "background": "rgba(255,255,255,0.06)",
      "border": "1.5px solid rgba(255,255,255,0.08)",
      "borderRadius": "12px",
      "focusBorder": "#F5C518",
      "placeholderColor": "rgba(255,248,231,0.2)"
    },
    "card": {
      "background": "#1f1a12",
      "border": "1px solid rgba(255,255,255,0.08)",
      "borderRadius": "20px",
      "padding": "28px"
    },
    "badge": {
      "padding": "4px 10px",
      "fontSize": "11px",
      "fontWeight": 700,
      "borderRadius": "100px"
    }
  },
  "accessibility": {
    "minContrastRatio": 4.5,
    "minFontSize": "11px",
    "minTapTarget": "44px",
    "focusRing": "0 0 0 3px rgba(245,197,24,0.5)"
  },
  "motion": {
    "reduceMotion": true,
    "defaultEasing": "cubic-bezier(0.4,0,0.2,1)",
    "springEasing": "cubic-bezier(0.34,1.4,0.64,1)",
    "easeOutQuint": "cubic-bezier(0.23,1,0.32,1)",
    "easeOutExpo": "cubic-bezier(0.19,1,0.22,1)",
    "disallowedEasings": [
      "cubic-bezier(0.34, 1.4, 0.64, 1)",
      "cubic-bezier(0.34, 1.6, 0.64, 1)"
    ],
    "disallowedTransitions": [
      "width",
      "height",
      "padding",
      "margin"
    ],
    "allowedTransformAnimations": [
      "transform",
      "opacity",
      "filter"
    ]
  }
}