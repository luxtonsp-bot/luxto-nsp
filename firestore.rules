// Firestore Security Rules for LUXTO-NSP
// Modelo de colecciones: PLAN_MIGRACION_LUXTO_NSP.md (sección 3)
// Reglas por rol: miembro / líder / coordinador (sección 4)
// NOTA: sin allows duplicados — Firestore rechaza statements solapados.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }

    function isAdminEmail() {
      return isAuth() && (
        request.auth.token.email == "henry.alfaro1@unmsm.edu.pe" ||
        request.auth.token.email == "paolosotil97@gmail.com" ||
        request.auth.token.email == "jorgediego.123.2002@gmail.com" ||
        request.auth.token.email == "gianfracamones@gmail.com" ||
        request.auth.token.email == "alvarorodrigosalazar.2001@gmail.com"
      );
    }

    function getMemberIdFromUid(uid) {
      let snap = get(/databases/$(database)/documents/uid_map/$(uid));
      return snap.data != null ? snap.data.memberId : null;
    }

    function isOwnMemberId(memberId) {
      return isAuth() && getMemberIdFromUid(request.auth.uid) == memberId;
    }

    function getUserRole(uid) {
      let memberId = getMemberIdFromUid(uid);
      return memberId == null ? null : get(/databases/$(database)/documents/members/$(memberId)).data.rol;
    }

    function isCoordinator() {
      return isAuth() && (getUserRole(request.auth.uid) == "coordinador" || isAdminEmail());
    }

    function isStaff() {
      let role = getUserRole(request.auth.uid);
      return isAuth() && (role == "servidor" || role == "apoyo" || role == "coordinador" || isAdminEmail());
    }

    // ── ARQUITECTURA CANÓNICA: members/{memberId} (UUID permanente) ──
    match /members/{memberId} {
      allow read: if isAuth();
      allow list: if isAuth();
      allow update: if (isOwnMemberId(memberId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rol', 'estadoAnioActual', 'fechaIngresoGrupo', 'ingresoInferido'])) || isCoordinator();
      allow update: if isAuth() && request.resource.data.uid == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rol', 'estadoAnioActual', 'fechaIngresoGrupo', 'ingresoInferido']);
      allow create: if isAuth() && request.auth.uid == resource.data.uid && (!('rol' in request.resource.data) || request.resource.data.rol == 'miembro');
      allow delete: if false;
    }

    // ── uid_map/{authUid} (enlace Auth ↔ memberId) ──
    match /uid_map/{uid} {
      allow read: if isAuth() && (request.auth.uid == uid || isStaff());
      allow create: if isAuth() && request.auth.uid == uid;
      allow update, delete: if false;
    }

    match /miembros_registro/{uid} {
      allow read: if true;
      allow create, update: if isAuth() && request.auth.uid == uid;
      allow delete: if isCoordinator();
    }

    match /asambleas/{fecha} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    match /asamblea/{docId} {
      allow read: if isAuth();
      allow create, update: if isStaff();
      allow delete: if isCoordinator();
    }

    // ASISTENCIA
    match /asistencia/{docId} {
      allow read: if isAuth() && (
        request.auth.uid == resource.data.uid ||
        get(/databases/$(database)/documents/uid_map/$(request.auth.uid)).data.memberId == resource.data.uid
      );
    }
    match /asistencia/{anio}/{fecha}/{memberId} {
      allow read: if isAuth() && (
        request.auth.uid == memberId ||
        get(/databases/$(database)/documents/uid_map/$(request.auth.uid)).data.memberId == memberId ||
        isStaff()
      );
      allow create, update: if isStaff();
      allow delete: if false;
    }

    match /tablas_definiciones/{tablaId} {
      allow read: if isAuth();
      allow create, update, delete: if isStaff();
    }

    match /tablas_dinamicas/{anio}/{tablaId}/{rowId} {
      function tablaRestringida() { return tablaId == 'lista-asistentes-ejutor-2026'; }
      allow read: if isAuth() && (!tablaRestringida() || isCoordinator());
      allow create, update: if (isStaff() && !tablaRestringida()) || isCoordinator();
      allow delete: if isCoordinator();
    }

    match /asambleas_kahoot/{fecha} {
      allow read: if isAuth();
      allow create, update: if isStaff();
      allow delete: if false;
    }

    match /historico/{anio}/{collection}/{docId} {
      allow read: if isAuth();
      allow create, update: if isCoordinator();
      allow delete: if false;
    }

    match /historico/{anio} {
      allow read: if isAuth();
      allow create, update: if isCoordinator();
      allow delete: if false;
    }

    match /sugerencias/{id} {
      allow read: if isAuth() && (get(/databases/$(database)/documents/members/$(getMemberIdFromUid(request.auth.uid))).data.rol in ["servidor", "apoyo", "coordinador"]);
      allow create: if isAuth();
      allow update, delete: if isAuth() && (request.auth.uid == resource.data.uid || isCoordinator());
    }

    match /suggestions/{id} {
      allow read: if isAuth() && (get(/databases/$(database)/documents/members/$(getMemberIdFromUid(request.auth.uid))).data.rol in ["servidor", "apoyo", "coordinador"]);
      allow create: if isAuth();
      allow update, delete: if isAuth() && (request.auth.uid == resource.data.uid || isCoordinator());
    }

    match /feedback/{id} {
      allow read: if isAuth() && (get(/databases/$(database)/documents/members/$(getMemberIdFromUid(request.auth.uid))).data.rol in ["servidor", "apoyo", "coordinador"]);
      allow create: if isAuth();
      allow update, delete: if isAuth() && (request.auth.uid == resource.data.uid || isCoordinator());
    }

    match /attendance_log/{docId} {
      allow read: if isAuth() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /preguntas/{id} {
      allow read: if isAuth();
      allow create, update: if isAuth() && (get(/databases/$(database)/documents/members/$(getMemberIdFromUid(request.auth.uid))).data.rol in ["servidor", "apoyo", "coordinador"]);
      allow delete: if isAuth() && (get(/databases/$(database)/documents/members/$(getMemberIdFromUid(request.auth.uid))).data.rol == "coordinador");
    }

    match /kahoot_sessions/{sessionId} {
      allow read: if isAuth();
      allow create, update: if isStaff();
      allow delete: if isCoordinator();
    }

    match /historico/{anio}/kahoot_sessions/{sessionId} {
      allow read: if isAuth();
      allow create, update: if isCoordinator();
      allow delete: if false;
    }
  }
}