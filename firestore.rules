// Firestore Security Rules for LUXTO-NSP
// Modelo de colecciones: PLAN_MIGRACION_LUXTO_NSP.md (sección 3)
// Reglas por rol: miembro / líder / coordinador (sección 4)
// NOTA: sin allows duplicados — Firestore rechaza statements solapados.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }

    function getMemberIdFromUid(uid) {
      let snap = get(/databases/$(database)/documents/uid_map/$(uid));
      return snap.data != null ? snap.data.memberId : null;
    }

    function isOwnMemberId(memberId) {
      return isAuth() && getMemberIdFromUid(request.auth.uid) == memberId;
    }

    function getUserRole(uid) {
      let memberId = getMemberIdFromUid(uid);
      return memberId == null ? null : get(/databases/$(database)/documents/members/$(memberId)).data.rol;
    }

    function isCoordinator() {
      return isAuth() && getUserRole(request.auth.uid) == "coordinador";
    }

    function isStaff() {
      let role = getUserRole(request.auth.uid);
      return isAuth() && (role == "servidor" || role == "apoyo" || role == "coordinador");
    }

    function roleTransferMatches(memberId, isTarget) {
      let transferPath = /databases/$(database)/documents/role_transfer_state/current;
      return existsAfter(transferPath)
        && (isTarget
          ? getAfter(transferPath).data.fromMemberId == getMemberIdFromUid(request.auth.uid)
            && getAfter(transferPath).data.toMemberId == memberId
          : getAfter(transferPath).data.fromMemberId == memberId
            && getAfter(transferPath).data.toMemberId is string
            && getAfter(transferPath).data.toMemberId != memberId
            && getAfter(/databases/$(database)/documents/members/$(getAfter(transferPath).data.toMemberId)).data.rol == 'coordinador'
            && memberAuthLinkMatchesAfter(getAfter(transferPath).data.toMemberId));
    }

    function memberAuthLinkMatchesAfter(memberId) {
      let memberAfter = getAfter(/databases/$(database)/documents/members/$(memberId));
      return memberAfter.data != null
        && memberAfter.data.uid is string
        && getAfter(/databases/$(database)/documents/uid_map/$(memberAfter.data.uid)).data.memberId == memberId;
    }

    function roleChangeAllowed(memberId) {
      let roleChanged = request.resource.data.diff(resource.data).affectedKeys().hasAny(['rol']);
      return !roleChanged || (
        isCoordinator() && (
          (request.resource.data.rol == 'coordinador' && roleTransferMatches(memberId, true))
          || (resource.data.rol == 'coordinador'
            && request.resource.data.rol in ['miembro', 'servidor', 'apoyo']
            && roleTransferMatches(memberId, false))
          || (resource.data.rol != 'coordinador'
            && request.resource.data.rol in ['miembro', 'servidor', 'apoyo'])
        )
      );
    }

    // ── ARQUITECTURA CANÓNICA: members/{memberId} (UUID permanente) ──
    match /members/{memberId} {
      allow read: if isAuth();
      allow list: if isAuth();
      allow update: if ((isCoordinator() && roleChangeAllowed(memberId))
        || (isStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nombre',
          'fechaNacimiento',
          'fechaNacimientoMMdd',
          'fechaIngresoGrupo',
          'fechaPrimeraAsamblea',
          'fechaActualizacion'
        ]))
        || (isStaff()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'asistenciasTotales',
            'ultimaAsistencia'
          ])
          && request.resource.data.asistenciasTotales == resource.data.get('asistenciasTotales', 0) + 1
          && request.resource.data.ultimaAsistencia is string)
        || (isStaff()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'estadoAnioActual',
            'asistenciasTotales',
            'ultimaAsistencia'
          ])
          && request.resource.data.estadoAnioActual == 'perseverante'
          && request.resource.data.asistenciasTotales == resource.data.get('asistenciasTotales', 0) + 1
          && request.resource.data.ultimaAsistencia is string)
        || (isOwnMemberId(memberId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rol', 'estadoAnioActual', 'fechaIngresoGrupo', 'ingresoInferido'])));
      allow update: if isAuth()
        && request.resource.data.uid == request.auth.uid
        && (
          resource.data.get('uid', null) == request.auth.uid
          || (
            resource.data.get('uid', null) in [null, '']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'email',
              'uid',
              'fechaNacimiento',
              'fechaNacimientoMMdd'
            ])
            && getAfter(/databases/$(database)/documents/uid_map/$(request.auth.uid)).data.memberId == memberId
          )
        )
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rol', 'estadoAnioActual', 'fechaIngresoGrupo', 'ingresoInferido']);
      // Permitir a staff crear placeholders (sin uid) y a usuarios crear su propio doc con su uid
      allow create: if isAuth() && (
        (isStaff() && (!('rol' in request.resource.data) || request.resource.data.rol == 'miembro') && !('uid' in request.resource.data))
        || (request.auth.uid == request.resource.data.uid && (!('rol' in request.resource.data) || request.resource.data.rol == 'miembro'))
      );
      allow delete: if false;
    }

    // ── uid_map/{authUid} (enlace Auth ↔ memberId) ──
    match /uid_map/{uid} {
      allow read: if isAuth() && (request.auth.uid == uid || isStaff());
      allow create: if isAuth() && request.auth.uid == uid;
      allow update, delete: if false;
    }

    match /role_transfer_state/{stateId} {
      allow read: if isCoordinator();
      allow create, update: if isCoordinator()
        && stateId == 'current'
        && request.resource.data.keys().hasOnly([
          'fromMemberId',
          'toMemberId',
          'outgoingRole',
          'updatedAt'
        ])
        && request.resource.data.fromMemberId == getMemberIdFromUid(request.auth.uid)
        && request.resource.data.fromMemberId != request.resource.data.toMemberId
        && request.resource.data.outgoingRole in ['miembro', 'servidor', 'apoyo']
        && getAfter(/databases/$(database)/documents/members/$(request.resource.data.fromMemberId)).data.rol == request.resource.data.outgoingRole
        && getAfter(/databases/$(database)/documents/members/$(request.resource.data.toMemberId)).data.rol == 'coordinador'
        && memberAuthLinkMatchesAfter(request.resource.data.toMemberId);
      allow delete: if false;
    }

    match /miembros_registro/{uid} {
      allow read: if true;
      allow create: if isStaff();
      allow update: if isCoordinator() || (
        isAuth()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'tieneCuenta'])
        && resource.data.get('tieneCuenta', false) == false
        && request.resource.data.tieneCuenta == true
        && request.resource.data.email is string
        && resource.data.memberId is string
        && getAfter(/databases/$(database)/documents/uid_map/$(request.auth.uid)).data.memberId == resource.data.memberId
        && getAfter(/databases/$(database)/documents/uid_map/$(request.auth.uid)).data.email == request.resource.data.email
      );
      allow delete: if isCoordinator();
    }

    match /asambleas/{fecha} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    match /asamblea/{docId} {
      allow read: if isAuth();
      allow create, update: if isStaff();
      allow delete: if isCoordinator();
    }

    // ASISTENCIA
    match /asistencia/{docId} {
      allow read: if isAuth() && (
        request.auth.uid == resource.data.uid ||
        get(/databases/$(database)/documents/uid_map/$(request.auth.uid)).data.memberId == resource.data.uid
      );
    }
    match /asistencia/{anio}/{fecha}/{memberId} {
      allow read: if isAuth() && (
        request.auth.uid == memberId ||
        get(/databases/$(database)/documents/uid_map/$(request.auth.uid)).data.memberId == memberId ||
        isStaff()
      );
      allow create: if isStaff();
      allow update: if isCoordinator() || (isAuth() && getUserRole(request.auth.uid) == "servidor");
      allow delete: if false;
    }

    match /tablas_definiciones/{tablaId} {
      allow read: if isAuth();
      allow create, update, delete: if isCoordinator();
    }

    match /tablas_dinamicas/{anio}/{tablaId}/{rowId} {
      function tablaRestringida() { return tablaId == 'lista-asistentes-ejutor-2026'; }
      allow read: if isAuth() && (!tablaRestringida() || isCoordinator());
      allow create, update: if isCoordinator();
      allow delete: if isCoordinator();
    }

    match /asambleas_kahoot/{fecha} {
      allow read: if isAuth();
      allow create, update: if isStaff();
      allow delete: if false;
    }

    match /historico/{anio}/{collection}/{docId} {
      allow read: if isAuth();
      allow create, update: if isCoordinator();
      allow delete: if false;
    }

    match /historico/{anio} {
      allow read: if isAuth();
      allow create, update: if isCoordinator();
      allow delete: if false;
    }

    match /sugerencias/{id} {
      allow read: if isAuth() && (get(/databases/$(database)/documents/members/$(getMemberIdFromUid(request.auth.uid))).data.rol in ["servidor", "apoyo", "coordinador"]);
      allow create: if isAuth();
      allow update, delete: if isAuth() && (request.auth.uid == resource.data.uid || isCoordinator());
    }

    match /suggestions/{id} {
      allow read: if isAuth() && (get(/databases/$(database)/documents/members/$(getMemberIdFromUid(request.auth.uid))).data.rol in ["servidor", "apoyo", "coordinador"]);
      allow create: if isAuth();
      allow update, delete: if isAuth() && (request.auth.uid == resource.data.uid || isCoordinator());
    }

    match /feedback/{id} {
      allow read: if isAuth() && (get(/databases/$(database)/documents/members/$(getMemberIdFromUid(request.auth.uid))).data.rol in ["servidor", "apoyo", "coordinador"]);
      allow create: if isAuth();
      allow update, delete: if isAuth() && (request.auth.uid == resource.data.uid || isCoordinator());
    }

    match /attendance_log/{docId} {
      allow read: if isAuth() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /preguntas/{id} {
      allow read: if isAuth();
      allow create, update: if isAuth() && (get(/databases/$(database)/documents/members/$(getMemberIdFromUid(request.auth.uid))).data.rol in ["servidor", "apoyo", "coordinador"]);
      allow delete: if isAuth() && (get(/databases/$(database)/documents/members/$(getMemberIdFromUid(request.auth.uid))).data.rol == "coordinador");
    }

    match /kahoot_sessions/{sessionId} {
      allow read: if isAuth();
      allow create, update: if isStaff();
      allow delete: if isCoordinator();
    }

    match /historico/{anio}/kahoot_sessions/{sessionId} {
      allow read: if isAuth();
      allow create, update: if isCoordinator();
      allow delete: if false;
    }
  }
}