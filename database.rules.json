{
  "rules": {
    ".read": false,
    ".write": false,
    "asamblea": {
      ".write": false,
      "sesion": {
        ".write": "root.child('admins').child(auth.uid).exists()",
        "fase": {
          ".write": "root.child('admins').child(auth.uid).exists()"
        },
        "cola": {
          ".write": "root.child('admins').child(auth.uid).exists()"
        },
        "indice": {
          ".write": "root.child('admins').child(auth.uid).exists()"
        },
        "claves": {
          "$qid": {
            ".read": "root.child('admins').child(auth.uid).exists()",
            ".write": "root.child('admins').child(auth.uid).exists()"
          }
        },
        "puntos": {
          "$uid": {
            ".write": "root.child('admins').child(auth.uid).exists()"
          }
        },
        "resumen": {
          ".write": "root.child('admins').child(auth.uid).exists()"
        },
        "acumulada": {
          ".write": "root.child('admins').child(auth.uid).exists()"
        },
        "hostUid": {
          ".write": "root.child('admins').child(auth.uid).exists()"
        }
      },
      "preguntaActual": {
        ".read": true,
        ".write": "root.child('admins').child(auth.uid).exists()"
      },
      "respuestas": {
        "$qid": {
          "$uid": {
            ".validate": "newData.child('idx').isNumber() && newData.child('idx').val() >= 0 && newData.child('idx').val() <= 3 && newData.child('ts').val() === now && !data.exists() && $qid === root.child('asamblea').child('preguntaActual').child('id').val()",
            ".write": "auth.uid === $uid && root.child('asamblea').child('sesion').child('fase').val() === 'pregunta' && now < root.child('asamblea').child('preguntaActual').child('cierraEn').val()"
          }
        }
      },
      "conectados": {
        "$uid": {
          ".write": "auth.uid === $uid",
          ".read": true
        }
      },
      "resumen": {
        ".read": true,
        ".write": "root.child('admins').child(auth.uid).exists()"
      }
    },
    "rankingGlobal": {
      "$key": {
        ".read": true,
        ".write": "root.child('admins').child(auth.uid).exists()"
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth.uid === $uid || root.child('admins').child(auth.uid).exists()",
        ".write": "root.child('admins').child(auth.uid).exists()"
      }
    },
    "borradores": {
      ".read": true,
      ".write": "root.child('admins').child(auth.uid).exists()"
    },
    "activa": {
      ".read": true,
      ".write": "root.child('admins').child(auth.uid).exists()"
    },
    "estado": {
      ".read": true,
      ".write": "root.child('admins').child(auth.uid).exists()"
    },
    "preguntaNum": {
      ".read": true,
      ".write": "root.child('admins').child(auth.uid).exists()"
    }
  }
}